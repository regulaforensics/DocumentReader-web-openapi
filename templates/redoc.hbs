  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      padding: 0;
      margin: 0;
    }

    /* Enum definitions use their Markdown table as the complete presentation. */
    [data-section-id^="schema/"] > div:nth-child(2) > div > div:nth-child(2),
